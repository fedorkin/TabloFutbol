{
  "name": "soccer-bot",
  "version": "1.0.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p test",
    "db:migrate": "wrangler d1 migrations apply soccer --remote",
    "db:migrate:local": "wrangler d1 migrations apply soccer --local"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
